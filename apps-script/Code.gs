// Trip page for this sheet. No home server needed.
// Setup (once): Deploy → New deployment → type "Web app" → Execute as: Me, Who has access: Anyone
// → Deploy → allow access → copy the Web app URL and open it on your phone (Share → Add to Home Screen).
// The page reads the 'Itinerary' tab every time it opens, so it is always up to date.

function doGet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const rows = ss.getSheetByName('Itinerary').getRange('A2:G').getDisplayValues();
  const days = [];
  rows.forEach(r => {
    const a = r[0].trim();
    if (/^D-?\d+(~D?\d+)?$/.test(a)) { days.push({ label: a, date: r[2].trim(), theme: r[3].trim(), items: [] }); return; }
    if (!days.length || !r.some(c => c.trim())) return;
    const pin = r[6].match(/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/);
    const t = a.match(/^(\d{1,2}):(\d{2})/);
    days[days.length - 1].items.push({
      time: t ? t[1].padStart(2, '0') + ':' + t[2] : a, type: r[1].trim(), title: r[2].trim(),
      map: r[3].trim(), remark: r[4].trim(), link: r[5].trim(), pin: pin ? [+pin[1], +pin[2]] : null });
  });
  // Put this page's link in the Setup tab (A13). On iPhone, copy it into Safari: Google's Sheets app cannot open it.
  const setup = ss.getSheetByName('Setup'), url = ScriptApp.getService().getUrl();
  if (setup && url && setup.getRange('A13').getFormula().indexOf(url) < 0) {
    setup.getRange('A12').setValue('Trip page link (copy it into Safari on iPhone; send it to travel companions):');
    setup.getRange('A13').setFormula('=HYPERLINK("' + url + '","Open trip page")');
  }
  const name = ss.getName();
  const data = JSON.stringify({ title: name, days: days,
    built: Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), 'yyyy-MM-dd HH:mm') }).replace(/<\//g, '<\\/');
  const safe = name.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const html = TEMPLATE.split('{{TITLE}}').join(safe).split('{{DATA}}').join(data);
  return HtmlService.createHtmlOutput(html).setTitle(name)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

