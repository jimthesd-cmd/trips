x; margin:8px 0 12px; }\nh2 span { color:var(--accent); margin-right:6px; }\n.row { display:grid; grid-template-columns:46px 1fr; gap:10px; margin-bottom:10px; }\n.time { color:var(--accent); font-weight:600; font-size:13px; padding-top:12px; text-align:right; }\n.card { background:var(--card); border-radius:14px; padding:12px 14px; box-shadow:0 1px 2px rgba(0,0,0,.06); }\n.card .t { font-weight:600; font-size:16px; }\n.num { display:inline-flex; width:22px; height:22px; border-radius:50%; background:var(--accent); color:#fff; font-size:12px; align-items:center; justify-content:center; margin-right:6px; vertical-align:2px; }\n.rem { color:var(--mute); font-size:13.5px; margin-top:4px; white-space:pre-wrap; }\n.acts { margin-top:8px; display:flex; gap:8px; flex-wrap:wrap; }\n.acts a { font-size:13px; color:var(--ink); background:var(--chip); padding:4px 10px; border-radius:99px; text-decoration:none; }\n.move { display:grid; grid-template-columns:46px 1fr; gap:10px; margin:-2px 0 8px; }\n.move .m { border-left:2px dashed var(--line); margin-left:10px; padding:2px 0 2px 14px; font-size:13.5px; }\n.move .m a { color:var(--mute); font-size:12px; margin-left:6px; }\n.move .m .rem { margin-top:0; }\n.day { display:block; background:var(--card); border-radius:14px; padding:12px 14px; margin-bottom:10px; cursor:pointer; }\n.day b { color:var(--accent); margin-right:8px; }\n.foot { color:var(--mute); font-size:12px; text-align:center; margin-top:24px; }\n.pin { background:var(--accent); color:#fff; border:2px solid #fff; border-radius:50%; width:26px !important; height:26px !important; display:flex; align-items:center; justify-content:center; font:600 12px sans-serif; box-shadow:0 1px 3px rgba(0,0,0,.4); }\n</style>\n</head>\n<body>\n<header><h1 id=\"title\"></h1><nav id=\"tabs\"></nav><div id=\"map\"></div></header>\n<main><div id=\"body\"></div><div class=\"foot\" id=\"foot\"></div></main>\n<script>\nconst DATA = {{DATA}};\nconst MOVE = new Set([\"飛\",\"車\",\"船\",\"行\"]);  // transport types; other types are cards\nconst tag = t => t ? `<span class=\"tag\">[${esc(t)}]</span>` : \"\";\nconst COLORS = [\"#e8742c\",\"#2f80ed\",\"#27ae60\",\"#9b51e0\",\"#eb5757\",\"#f2c94c\",\"#00a3a3\",\"#bb6bd9\"];\nconst esc = s => String(s ?? \"\").replace(/[&<>\"]/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nconst url = s => /^https?:\\/\\//.test(s) ? esc(s) : \"\";\nconst store = { get(k){ try { return localStorage.getItem(k); } catch(e) { return null; } },\n                set(k,v){ try { localStorage.setItem(k,v); } catch(e) {} } };\n\ndocument.title = DATA.title;\ndocument.getElementById(\"title\").textContent = DATA.title;\ndocument.getElementById(\"foot\").textContent = \"Updated \" + DATA.built;\n\n// If the map library cannot load (offline, blocked), show the itinerary without the map.\nconst HAS_MAP = typeof L !== \"undefined\";\nif (!HAS_MAP) document.getElementById(\"map\").style.display = \"none\";\nconst map = HAS_MAP ? L.map(\"map\", { zoomControl:true }) : null;\nif (HAS_MAP) L.tileLayer(\"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png\", { maxZoom:19, attribution:\"© OpenStreetMap\" }).addTo(map);\nlet layer = HAS_MAP ? L.layerGroup().addTo(map) : null;\nconst icon = (n, color) => L.divIcon({ className:\"\", html:`<div class=\"pin\" style=\"background:${color}\">${n}</div>`, iconSize:[26,26], iconAnchor:[13,13] });\n\nfunction draw(points, color, label) {\n  // points: [[lat,lng,title], ...]\n  if (!HAS_MAP || !points.length) return [];\n  L.polyline(points.map(p => [p[0], p[1]]), { color, weight:3, opacity:.7 }).addTo(layer);\n  points.forEach((p, i) => L.marker([p[0], p[1]], { icon: icon(label ? label(i) : i + 1, color) }).bindPopup(esc(p[2])).addTo(layer));\n  return points.map(p => [p[0], p[1]]);\n}\nfunction fit(all) {\n  if (!HAS_MAP) return;\n  if (all.length > 1) map.fitBounds(all, { padding:[24,24] });\n  else if (all.length === 1) map.setView(all[0], 15);\n  else map.setView([35, 135], 4);\n}\n// One pin per place per day: the same hotel twice in a day shows once.\nfunction dayPins(d) {\n  const seen = new Set(), out = [];\n  d.items.forEach(it => { if (it.pin) { const k = it.pin.join(); if (!seen.has(k)) { seen.add(k); out.push([it.pin[0], it.pin[1], it.title, it]); } } });\n  return out;\n}\n\nfunction tabs(active) {\n  const nav = document.getElementById(\"tabs\");\n  nav.innerHTML = `<button data-i=\"-1\"><b>Overview</b><small>&nbsp;</small></button>` +\n    DATA.days.map((d, i) => `<button data-i=\"${i}\"><b>${esc(d.label)}</b><small>${esc(String(d.date).replace(/^\\d{4}-(\\d\\d)-(\\d\\d)/, (_, mo, da) => `${+da}/${+mo}`))}</small></button>`).join(\"\");\n  nav.querySelectorAll(\"button\").forEach(b => { b.classList.toggle(\"on\", +b.dataset.i === active); b.onclick = () => show(+b.dataset.i); });\n  nav.querySelector(\".on\")?.scrollIntoView({ inline:\"center\", block:\"nearest\" });\n}\n\nfunction overview() {\n  let all = [];\n  // Overview: every pin shows its day number, in that day's colour.\n  DATA.days.forEach((d, i) => { all = all.concat(draw(dayPins(d), COLORS[i % COLORS.length], () => i + 1)); });\n  fit(all);\n  return DATA.days.map((d, i) => `<a class=\"day\" data-i=\"${i}\"><b style=\"color:${COLORS[i % COLORS.length]}\">${esc(d.label)}</b>${esc(d.date)}<div class=\"rem\">${esc(d.theme)}</div></a>`).join(\"\");\n}\n\nfunction day(i) {\n  const d = DATA.days[i], pins = dayPins(d), num = new Map();\n  pins.forEach((p, n) => num.set(p[3].pin.join(), n + 1));\n  fit(draw(pins, COLORS[0]));\n  let h = `<h2><span>${esc(d.label)}</span>${esc(d.theme)}</h2>`;\n  d.items.forEach(it => {\n    const links = `${url(it.map) ? `<a href=\"${url(it.map)}\" target=\"_blank\" rel=\"noopener\">${MOVE.has(it.type) ? \"Route\" : \"Map\"}</a>` : \"\"}${url(it.link) ? `<a href=\"${url(it.link)}\" target=\"_blank\" rel=\"noopener\">${MOVE.has(it.type) ? \"Timetable\" : \"Website\"}</a>` : \"\"}`;\n    if (MOVE.has(it.type) && !it.pin) {\n      h += `<div class=\"move\"><div class=\"time\">${esc(it.time)}</div><div class=\"m\">${tag(it.type)}${esc(it.title)}${it.remark ? `<div class=\"rem\">${esc(it.remark)}</div>` : \"\"}${links ? `<div class=\"acts\">${links}</div>` : \"\"}</div></div>`;\n    } else {\n      const n = it.pin ? num.get(it.pin.join()) : null;\n      h += `<div class=\"row\"><div class=\"time\">${esc(it.time)}</div><div class=\"card\"><div class=\"t\">${n ? `<span class=\"num\">${n}</span>` : \"\"}${tag(it.type)}${esc(it.title)}</div>${it.remark ? `<div class=\"rem\">${esc(it.remark)}</div>` : \"\"}${links ? `<div class=\"acts\">${links}</div>` : \"\"}</div></div>`;\n    }\n  });\n  return h;\n}\n\nfunction show(i) {\n  if (HAS_MAP) layer.clearLayers();\n  const body = document.getElementById(\"body\");\n  body.innerHTML = i < 0 ? overview() : day(i);\n  body.querySelectorAll(\".day\").forEach(a => a.onclick = () => show(+a.dataset.i));\n  tabs(i);\n  store.set(\"tab:\" + DATA.title, i);\n  window.scrollTo(0, 0);\n}\n\nconst today = new Date().toISOString().slice(0, 10);\nconst t = DATA.days.findIndex(d => String(d.date).startsWith(today));\nconst saved = store.get(\"tab:\" + DATA.title);\nshow(t >= 0 ? t : (saved !== null && +saved < DATA.days.length ? +saved : -1));\n\nif (\"serviceWorker\" in navigator) navigator.serviceWorker.register(\"sw.js\").catch(() => {});\n</script>\n</body>\n</html>\n";
